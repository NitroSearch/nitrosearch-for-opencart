 #
 # OpenCart 4 admin markup — Bootstrap 5. The OpenCart 3 build carries the same
 # screen against Bootstrap 3, which is why this file has a twin rather than being
 # shared: the two admin themes disagree on card/panel, float-end/pull-right and
 # the whole grid vocabulary.
 #}
{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ text_extension }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>

  <div class="container-fluid">
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-magnifying-glass"></i> {{ text_edit }}</div>
      <div class="card-body">

        {% if connected %}
          <div class="alert alert-success"><i class="fa-solid fa-circle-check"></i> {{ text_connected }}</div>
        {% else %}
          <div class="alert alert-info"><i class="fa-solid fa-circle-info"></i> {{ text_not_connected }}</div>
        {% endif %}

        <div id="ns-actions" class="mb-3">
          {% if connected %}
            <button type="button" id="ns-refresh" class="btn btn-primary" data-url="{{ action_refresh }}">{{ text_refresh }}</button>
            <button type="button" id="ns-sync" class="btn btn-light" data-url="{{ action_sync }}">{{ text_sync }}</button>
            <button type="button" id="ns-disconnect" class="btn btn-light" data-url="{{ action_disconnect }}">{{ text_disconnect }}</button>
          {% else %}
            <button type="button" id="ns-connect" class="btn btn-primary" data-url="{{ action_connect }}">{{ text_connect }}</button>
          {% endif %}
          <div id="ns-result" class="form-text"></div>
        </div>

        <dl class="row">
          <dt class="col-sm-3">{{ text_shop_url }}</dt>
          <dd class="col-sm-9"><code>{{ shop_url }}</code></dd>

          <dt class="col-sm-3">{{ text_verify_url }}</dt>
          <dd class="col-sm-9">
            <a href="{{ verify_url }}" target="_blank" rel="noopener"><code>{{ verify_url }}</code></a>
            <div class="form-text">{{ text_verify_help }}</div>
          </dd>

          {# NOT A LINK, unlike the verify url above. This one carries the cron token,
             and a browser that follows it hands that token to whatever the merchant's
             referrer settings and history sync send it to — while doing a real drain
             on the spot. It is for copying into a scheduler, so it is rendered as
             text. #}
          <dt class="col-sm-3">{{ text_cron_url }}</dt>
          <dd class="col-sm-9">
            <code class="user-select-all">{{ cron_url }}</code>
            <div class="form-text">{{ text_cron_help }}</div>
          </dd>

          {# CHECKED FROM WHAT WAS STORED, never from a default written here. A
             privacy control whose position is not read back from the setting can
             show "on" while the value says otherwise, which is worse than having
             no control at all. #}
          <dt class="col-sm-3">{{ text_share_data }}</dt>
          <dd class="col-sm-9">
            <div class="form-check form-switch">
              <input type="checkbox" id="ns-share-data" class="form-check-input"
                     data-url="{{ action_share_data }}"{% if share_search_data %} checked{% endif %}>
              <label class="form-check-label" for="ns-share-data">{{ text_share_data }}</label>
            </div>
            <div class="form-text">{{ text_share_data_help }}</div>
          </dd>
        </dl>

      </div>
    </div>
  </div>
</div>

<script>
// Both admin themes ship jQuery, so one script serves both builds. Every action
// answers JSON and the page is reloaded on success rather than patched — the
// screen's state comes from the server, and re-rendering it is both simpler and
// impossible to get out of step with what was actually stored.
$(function () {
  // The privacy toggle posts its NEW position and does NOT reload — reloading a
  // page the merchant is reading to decide something is hostile, and the only
  // thing that changed is this one control. On failure the checkbox is put back
  // where it was, so its position never claims a setting that was not stored.
  $('#ns-share-data').on('change', function () {
    var $c = $(this), on = $c.is(':checked');
    $c.prop('disabled', true);
    $('#ns-result').text('…');
    $.ajax({
      url: $c.data('url'), type: 'POST', dataType: 'json', data: { share: on ? '1' : '0' },
      success: function (json) {
        if (json && json.ok) { $('#ns-result').text('Saved.'); }
        else { $c.prop('checked', !on); $('#ns-result').text((json && json.error) ? json.error : 'Failed.'); }
        $c.prop('disabled', false);
      },
      error: function (xhr) {
        $c.prop('checked', !on);
        $('#ns-result').text('HTTP ' + xhr.status);
        $c.prop('disabled', false);
      }
    });
  });

  $('#ns-actions').on('click', 'button[data-url]', function () {
    var $b = $(this);
    $b.prop('disabled', true);
    $('#ns-result').text('…');
    $.ajax({
      url: $b.data('url'), type: 'POST', dataType: 'json',
      success: function (json) {
        if (json && json.ok) { location.reload(); return; }
        $('#ns-result').text((json && json.error) ? json.error : 'Failed.');
        $b.prop('disabled', false);
      },
      error: function (xhr) {
        $('#ns-result').text('HTTP ' + xhr.status);
        $b.prop('disabled', false);
      }
    });
  });
});
</script>
{{ footer }}
