 #
 # OpenCart 3 admin markup — Bootstrap 3. The OpenCart 4 build carries the same
 # screen against Bootstrap 5, which is why this file has a twin rather than being
 # shared: the two admin themes disagree on panel/card, pull-right/float-end and
 # the whole grid vocabulary.
 #}
{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <a href="{{ back }}" data-toggle="tooltip" title="{{ text_extension }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>

  <div class="container-fluid">
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-search"></i> {{ text_edit }}</h3>
      </div>
      <div class="panel-body">

        {% if saved %}
          <div class="alert alert-success"><i class="fa fa-check-circle"></i> {{ text_saved }}</div>
        {% endif %}
        {% if connected %}
          <div class="alert alert-success"><i class="fa fa-check-circle"></i> {{ text_connected }}</div>
        {% else %}
          <div class="alert alert-info"><i class="fa fa-info-circle"></i> {{ text_not_connected }}</div>
        {% endif %}

        <div id="ns-actions" class="form-group">
          {% if connected %}
            <button type="button" id="ns-refresh" class="btn btn-primary" data-url="{{ action_refresh }}">{{ text_refresh }}</button>
            <button type="button" id="ns-sync" class="btn btn-default" data-url="{{ action_sync }}">{{ text_sync }}</button>
            <button type="button" id="ns-disconnect" class="btn btn-default" data-url="{{ action_disconnect }}">{{ text_disconnect }}</button>
          {% else %}
            <button type="button" id="ns-connect" class="btn btn-primary" data-url="{{ action_connect }}">{{ text_connect }}</button>
          {% endif %}
          <span id="ns-result" class="help-block"></span>
        </div>

        <dl class="dl-horizontal">
          <dt>{{ text_shop_url }}</dt>
          <dd><code>{{ shop_url }}</code></dd>

          <dt>{{ text_verify_url }}</dt>
          <dd>
            <a href="{{ verify_url }}" target="_blank" rel="noopener"><code>{{ verify_url }}</code></a>
            <p class="help-block">{{ text_verify_help }}</p>
          </dd>

          {# NOT A LINK, unlike the verify url above. This one carries the cron token,
             and a browser that follows it hands that token to whatever the merchant's
             referrer settings and history sync send it to — while doing a real drain
             on the spot. It is for copying into a scheduler, so it is rendered as
             text. #}
          <dt>{{ text_cron_url }}</dt>
          <dd>
            <code>{{ cron_url }}</code>
            <p class="help-block">{{ text_cron_help }}</p>
          </dd>

          {# CHECKED FROM WHAT WAS STORED, never from a default written here. A
             privacy control whose position is not read back from the setting can
             show "on" while the value says otherwise, which is worse than having
             no control at all. #}
          <dt>{{ text_share_data }}</dt>
          <dd>
            <div class="checkbox">
              <label>
                <input type="checkbox" id="ns-share-data"
                       data-url="{{ action_share_data }}"{% if share_search_data %} checked{% endif %}>
                {{ text_share_data }}
              </label>
            </div>
            <p class="help-block">{{ text_share_data_help }}</p>
          </dd>
        </dl>

        {# ─────────── Appearance and behaviour ───────────
           A PLAIN FORM POST, not the AJAX the buttons above use. Those are actions
           with a result to report; this is a settings save, and a normal submit
           means the screen a merchant sees after saving is rendered from what was
           actually stored rather than from what the browser believed it sent. #}
        {% if connected %}
        <hr />
        <form action="{{ action_save }}" method="post">
          <h5>{{ text_appearance }}</h5>
          <p class="help-block">{{ text_appearance_help }}</p>

          <div class="form-group">
            <label for="ns-look" class="col-sm-3 control-label">{{ text_look }}</label>
            <div class="col-sm-9">
              <select name="design_look" id="ns-look" class="form-control">
                {% for value, label in looks %}
                  <option value="{{ value }}"{% if design_look == value %} selected{% endif %}>{{ label }}</option>
                {% endfor %}
              </select>
            </div>
          </div>

          <div class="form-group">
            <label for="ns-scheme" class="col-sm-3 control-label">{{ text_scheme }}</label>
            <div class="col-sm-9">
              <select name="design_scheme" id="ns-scheme" class="form-control">
                {% for value, label in schemes %}
                  <option value="{{ value }}"{% if design_scheme == value %} selected{% endif %}>{{ label }}</option>
                {% endfor %}
              </select>
            </div>
          </div>

          <div class="form-group">
            <label for="ns-corners" class="col-sm-3 control-label">{{ text_corners }}</label>
            <div class="col-sm-9">
              <select name="design_corners" id="ns-corners" class="form-control">
                {% for value, label in corners %}
                  <option value="{{ value }}"{% if design_corners == value %} selected{% endif %}>{{ label }}</option>
                {% endfor %}
              </select>
            </div>
          </div>

          <div class="form-group">
            <label for="ns-accent" class="col-sm-3 control-label">{{ text_accent }}</label>
            <div class="col-sm-9">
              {# `type=color` cannot express "unset", so the text input is the real
                 control and the picker is a convenience beside it. #}
              <div class="input-group">
                <input type="color" class="form-control form-control" id="ns-accent-picker"
                       value="{{ design_accent ?: '#2563eb' }}" aria-label="{{ text_accent }}">
                <input type="text" name="design_accent" id="ns-accent" class="form-control"
                       value="{{ design_accent }}" placeholder="#2563eb" maxlength="7">
              </div>
              <div class="help-block">{{ text_accent_help }}</div>
            </div>
          </div>

          <div class="form-group">
            <label for="ns-width" class="col-sm-3 control-label">{{ text_width }}</label>
            <div class="col-sm-9">
              <select name="design_width" id="ns-width" class="form-control">
                {% for value, label in widths %}
                  <option value="{{ value }}"{% if design_width == value %} selected{% endif %}>{{ label }}</option>
                {% endfor %}
              </select>
            </div>
          </div>

          <div class="form-group">
            <label for="ns-filters" class="col-sm-3 control-label">{{ text_filters }}</label>
            <div class="col-sm-9">
              <select name="design_filters" id="ns-filters" class="form-control">
                {% for value, label in filters %}
                  <option value="{{ value }}"{% if design_filters == value %} selected{% endif %}>{{ label }}</option>
                {% endfor %}
              </select>
            </div>
          </div>

          <h5>{{ text_behaviour }}</h5>

          <div class="form-group">
            <div class="col-sm-9 col-sm-offset-3">
              <div class="checkbox">
                <input type="checkbox" name="results_takeover" value="1" id="ns-results"
                       {% if results_takeover %} checked{% endif %}>
                <label class="control-label" for="ns-results">{{ text_results_takeover }}</label>
              </div>
              <div class="help-block">{{ text_results_help }}</div>
            </div>
          </div>

          <div class="form-group">
            <div class="col-sm-9 col-sm-offset-3">
              <div class="checkbox">
                <input type="checkbox" name="show_badge" value="1" id="ns-badge"
                       {% if show_badge %} checked{% endif %}>
                <label class="control-label" for="ns-badge">{{ text_show_badge }}</label>
              </div>
              <div class="help-block">{{ text_badge_help }}</div>
            </div>
          </div>

          <div class="row">
            <div class="col-sm-9 col-sm-offset-3">
              <button type="submit" class="btn btn-primary">{{ text_save }}</button>
            </div>
          </div>
        </form>
        {% endif %}

        {% if not connected %}
        <hr />
        <form action="{{ action_save }}" method="post">
          <div class="form-group">
            <label for="ns-api-url" class="col-sm-3 control-label">{{ text_api_url }}</label>
            <div class="col-sm-9">
              <input type="url" name="api_url" id="ns-api-url" class="form-control" value="{{ api_url }}">
              <div class="help-block">{{ text_api_url_help }}</div>
            </div>
          </div>
          <div class="form-group">
            <div class="col-sm-9 col-sm-offset-3">
              <button type="submit" class="btn btn-default">{{ text_save }}</button>
            </div>
          </div>
        </form>
        {% endif %}

      </div>
    </div>
  </div>
</div>

<script>
// Both admin themes ship jQuery, so one script serves both builds. Every action
// answers JSON and the page is reloaded on success rather than patched — the
// screen's state comes from the server, and re-rendering it is both simpler and
// impossible to get out of step with what was actually stored.
$(function () {
  // The privacy toggle posts its NEW position and does NOT reload — reloading a
  // page the merchant is reading to decide something is hostile, and the only
  // thing that changed is this one control. On failure the checkbox is put back
  // where it was, so its position never claims a setting that was not stored.
  $('#ns-share-data').on('change', function () {
    var $c = $(this), on = $c.is(':checked');
    $c.prop('disabled', true);
    $('#ns-result').text('…');
    $.ajax({
      url: $c.data('url'), type: 'POST', dataType: 'json', data: { share: on ? '1' : '0' },
      success: function (json) {
        if (json && json.ok) { $('#ns-result').text('Saved.'); }
        else { $c.prop('checked', !on); $('#ns-result').text((json && json.error) ? json.error : 'Failed.'); }
        $c.prop('disabled', false);
      },
      error: function (xhr) {
        $c.prop('checked', !on);
        $('#ns-result').text('HTTP ' + xhr.status);
        $c.prop('disabled', false);
      }
    });
  });

  $('#ns-actions').on('click', 'button[data-url]', function () {
    var $b = $(this);
    $b.prop('disabled', true);
    $('#ns-result').text('…');
    $.ajax({
      url: $b.data('url'), type: 'POST', dataType: 'json',
      success: function (json) {
        if (json && json.ok) { location.reload(); return; }
        $('#ns-result').text((json && json.error) ? json.error : 'Failed.');
        $b.prop('disabled', false);
      },
      error: function (xhr) {
        $('#ns-result').text('HTTP ' + xhr.status);
        $b.prop('disabled', false);
      }
    });
  });
});
</script>
{{ footer }}
